<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:c="Garabandic.UiCdn.Editor.Preview">
  <ui:Style src="../../Themes/theme-tokens.uss" />
  <ui:Style src="../../Themes/theme-dark.uss" />
  <ui:Style src="../Core/UiCore.uss" />
  <ui:Style src="../Button/UiButton.uss" />
  <ui:Style src="../TreasureShop/UiTreasureShop.uss" />
  <ui:Style src="../../Themes/theme-royal-puzzle.uss" />
  <ui:VisualElement class="ui-root ui-theme-royal-puzzle">
    <c:UiTreasureShop>
  <ui:VisualElement class="treasury-bar">
    <ui:Label text="Shop" class="treasury-title" />
    <ui:VisualElement class="treasury-wallet"><ui:VisualElement class="treasury-wallet-coin" /><ui:Label text="2,040" /></ui:VisualElement>
  </ui:VisualElement>
  <ui:VisualElement class="treasury-feature">
    <ui:Label text="King’s Treasury" class="treasury-feature-title" />
    <ui:VisualElement class="treasury-loot">
      <ui:VisualElement class="treasury-jackpot"><ui:VisualElement class="treasury-chest art-chest" /><ui:Label text="25,000" class="treasury-prize" /></ui:VisualElement>
      <ui:VisualElement class="treasury-rewards">
        <ui:VisualElement class="treasury-reward" tooltip="Rockets">
      <ui:VisualElement class="treasury-reward-art art-rocket" />
      <ui:Label class="treasury-quantity" text="×12" />
    </ui:VisualElement><ui:VisualElement class="treasury-reward" tooltip="Hammers">
      <ui:VisualElement class="treasury-reward-art art-hammer" />
      <ui:Label class="treasury-quantity" text="×5" />
    </ui:VisualElement><ui:VisualElement class="treasury-reward" tooltip="Unlimited lives">
      <ui:VisualElement class="treasury-reward-art art-heart" />
      <ui:Label class="treasury-quantity" text="2h" />
    </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement class="treasury-deal"><ui:Label text="Treasure bundle" /><c:UiButton name="treasure-bundle" text="$12.99" class="treasury-price ui-game-action" /></ui:VisualElement>
  </ui:VisualElement>
  <ui:Label class="treasury-section" text="Coin packs" />
  <ui:VisualElement class="treasury-pack">
    <ui:VisualElement class="treasury-money art-coins" />
    <ui:Label class="treasury-count" text="1,000" />
    <c:UiButton name="pocket" text="$1.99" class="treasury-price ui-game-action" />
  </ui:VisualElement>
  <ui:VisualElement class="treasury-pack">
    <ui:VisualElement class="treasury-money art-pouch" />
    <ui:Label class="treasury-count" text="5,000" />
    <c:UiButton name="pouch" text="$4.99" class="treasury-price ui-game-action" />
  </ui:VisualElement>
  <ui:VisualElement class="treasury-pack">
    <ui:VisualElement class="treasury-money art-chest" />
    <ui:Label class="treasury-count" text="10,000" />
    <c:UiButton name="chest" text="$8.99" class="treasury-price ui-game-action" />
  </ui:VisualElement>
</c:UiTreasureShop>
  </ui:VisualElement>
</ui:UXML>
