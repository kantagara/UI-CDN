      <c:UiGearItem name="cinder" class="gear-art-cinder" item-name="Cinder Axe" equipment-slot="Weapon" rarity="Epic" attack="43" guard="2" initially-equipped="false" icon="Art/cinder.png" />
      <c:UiGearItem name="oak" class="gear-art-oak" item-name="Iron Round" equipment-slot="Shield" rarity="Common" attack="2" guard="18" initially-equipped="true" icon="Art/oak.png" />
      <c:UiGearItem name="sun" class="gear-art-sun" item-name="Sunward" equipment-slot="Shield" rarity="Rare" attack="6" guard="25" initially-equipped="false" icon="Art/sun.png" />
      <c:UiGearItem name="moon" class="gear-art-moon" item-name="Moonveil" equipment-slot="Shield" rarity="Epic" attack="3" guard="32" initially-equipped="false" icon="Art/moon.png" />
    </c:UiArmory>
